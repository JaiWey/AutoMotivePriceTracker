@page "/product/{Id:int}"
@rendermode InteractiveServer
@inject IProductCatalogService Catalog

<PageTitle>@(_product?.Name ?? "Product") — AutoPrice NZ</PageTitle>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_product == null)
{
    <p>Product not found.</p>
}
else
{
    <div class="product-detail">
        <div class="product-detail-header">
            @if (!string.IsNullOrEmpty(_product.ImageUrl))
            {
                <img src="@_product.ImageUrl" alt="@_product.Name" class="detail-image" />
            }
            <div class="detail-meta">
                <RetailerBadge RetailerValue="@_product.Retailer" />
                @if (!string.IsNullOrEmpty(_product.Category))
                {
                    <span class="category-tag">@_product.Category</span>
                }
                <h1>@_product.Name</h1>
                @if (!string.IsNullOrEmpty(_product.Brand))
                {
                    <p class="brand">Brand: @_product.Brand</p>
                }

                @if (_latest != null)
                {
                    <div class="price-row large">
                        <span class="current-price">$@_latest.Price.ToString("F2")</span>
                        @if (_latest.IsOnSale && _latest.WasPrice.HasValue)
                        {
                            <span class="was-price">was $@_latest.WasPrice.Value.ToString("F2")</span>
                            <span class="discount-badge">-@_latest.DiscountPercent%</span>
                        }
                    </div>
                }

                <p class="last-checked">Last checked: @_product.LastChecked.ToLocalTime().ToString("g")</p>
                <a href="@_product.SourceUrl" target="_blank" class="btn-secondary">View on @_product.Retailer</a>
            </div>
        </div>

        <div class="price-history-section">
            <h2>Price History</h2>
            <PriceChart Records="_product.PriceHistory" />
        </div>

        <div class="price-history-table">
            <h2>Price Records</h2>
            <table>
                <thead>
                    <tr><th>Date</th><th>Price</th><th>Was</th><th>Discount</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in _product.PriceHistory.OrderByDescending(r => r.Date))
                    {
                        <tr>
                            <td>@r.Date.ToLocalTime().ToString("g")</td>
                            <td>$@r.Price.ToString("F2")</td>
                            <td>@(r.WasPrice.HasValue ? $"${r.WasPrice.Value:F2}" : "-")</td>
                            <td>@(r.DiscountPercent.HasValue ? $"{r.DiscountPercent}%" : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductDetailDto? _product;
    private PricePointDto? _latest;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _product = await Catalog.GetProductAsync(Id);
        _latest = _product?.LatestPrice;
        _loading = false;
    }
}
