@page "/"
@rendermode InteractiveServer
@inject IProductCatalogService Catalog

<PageTitle>AutoPrice NZ — Automotive Deals</PageTitle>

<div class="home-hero">
    <h1>NZ Automotive Price Tracker</h1>
    <p>Compare prices from Repco and SupercheapAuto</p>
    <a href="/products" class="btn-primary">Browse All Products</a>
</div>

<section class="section">
    <h2>Current Deals</h2>
    @if (_loading)
    {
        <p>Loading...</p>
    }
    else if (_deals.Count == 0)
    {
        <p class="empty-state">No deals found yet. Visit <a href="/admin">Admin</a> to trigger a scrape.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in _deals)
            {
                <ProductCard Product="@p" />
            }
        </div>
    }
</section>

<section class="section">
    <h2>Recently Updated</h2>
    @if (!_loading && _recent.Count == 0)
    {
        <p class="empty-state">No products tracked yet.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in _recent)
            {
                <ProductCard Product="@p" />
            }
        </div>
    }
</section>

<div class="stats-bar">
    <div class="stat">
        <span class="stat-value">@_totalProducts</span>
        <span class="stat-label">Products tracked</span>
    </div>
    <div class="stat">
        <span class="stat-value">@_repcoCount</span>
        <span class="stat-label">Repco</span>
    </div>
    <div class="stat">
        <span class="stat-value">@_scaCount</span>
        <span class="stat-label">SupercheapAuto</span>
    </div>
</div>

@code {
    private IReadOnlyList<ProductSummaryDto> _deals = [];
    private IReadOnlyList<ProductSummaryDto> _recent = [];
    private bool _loading = true;
    private int _totalProducts, _repcoCount, _scaCount;

    protected override async Task OnInitializedAsync()
    {
        var summary = await Catalog.GetHomeSummaryAsync();

        _deals = summary.Deals;
        _recent = summary.Recent;
        _totalProducts = summary.TotalProducts;
        _repcoCount = summary.CountByRetailer.GetValueOrDefault(Retailer.Repco);
        _scaCount = summary.CountByRetailer.GetValueOrDefault(Retailer.SupercheapAuto);

        _loading = false;
    }
}
