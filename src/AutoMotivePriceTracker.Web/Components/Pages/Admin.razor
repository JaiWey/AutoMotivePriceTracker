@page "/admin"
@rendermode InteractiveServer
@inject IServiceProvider Services
@inject ILogger<Admin> Logger

<PageTitle>Admin — AutoPrice NZ</PageTitle>

<div class="admin-page">
    <h1>Admin</h1>

    <section class="admin-section">
        <h2>Manual Scrape</h2>
        <p>Trigger a full scrape of both Repco and SupercheapAuto now.</p>
        <button class="btn-primary" @onclick="RunScrape" disabled="@_scraping">
            @(_scraping ? "Scraping..." : "Run Scrape Now")
        </button>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="status-message @(_isError ? "error" : "success")">@_statusMessage</div>
        }
    </section>
</div>

@code {
    private bool _scraping;
    private string _statusMessage = "";
    private bool _isError;

    private async Task RunScrape()
    {
        _scraping = true;
        _statusMessage = "";
        StateHasChanged();

        try
        {
            using var scope = Services.CreateScope();
            var service = scope.ServiceProvider.GetRequiredService<AutoMotivePriceTracker.Application.Services.IPriceScrapingService>();
            await service.RunAllAsync();
            _statusMessage = "Scrape completed successfully.";
            _isError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Manual scrape failed");
            _statusMessage = $"Scrape failed: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _scraping = false;
        }
    }
}
