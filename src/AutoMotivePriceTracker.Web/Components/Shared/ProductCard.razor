@if (Product != null)
{
    var latest = Product.LatestPrice;
    <div class="product-card">
        <a href="/product/@Product.Id" class="product-card-link">
            @if (!string.IsNullOrEmpty(Product.ImageUrl))
            {
                <div class="product-image-wrap">
                    <img src="@Product.ImageUrl" alt="@Product.Name" class="product-image" loading="lazy" />
                </div>
            }
            else
            {
                <div class="product-image-wrap product-image-placeholder">
                    <span>🔧</span>
                </div>
            }

            <div class="product-info">
                <RetailerBadge RetailerValue="@Product.Retailer" />
                @if (!string.IsNullOrEmpty(Product.Category))
                {
                    <span class="category-tag">@Product.Category</span>
                }
                <h3 class="product-name">@Product.Name</h3>

                @if (latest != null)
                {
                    <div class="price-row">
                        <span class="current-price">$@latest.Price.ToString("F2")</span>
                        @if (latest.IsOnSale && latest.WasPrice.HasValue)
                        {
                            <span class="was-price">was $@latest.WasPrice.Value.ToString("F2")</span>
                            <span class="discount-badge">-@latest.DiscountPercent%</span>
                        }
                    </div>
                }
            </div>
        </a>
    </div>
}

@code {
    [Parameter, EditorRequired] public ProductSummaryDto? Product { get; set; }
}
